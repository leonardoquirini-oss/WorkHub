# Copy to .env for local development. Never commit .env.
# All values are optional: defaults are in src/api/config.ts.
# In Docker the same variables can be set at container start (written to /config.js).

# Keycloak (the browser talks to Keycloak directly: must be reachable from the tablet)
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=gb-realm
VITE_KEYCLOAK_CLIENT_ID=berlink-client

# Backend API base path. Keep /api and let the dev proxy / nginx forward it.
VITE_API_URL=/api

# Default site when none was selected before
VITE_DEFAULT_SITE_ID=1

# Dev server only: where `vite` proxies /api (BERLink backend)
VITE_DEV_PROXY_TARGET=http://localhost:8090
