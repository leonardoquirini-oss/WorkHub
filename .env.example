# Copy to .env for local development. Never commit .env.
# For `npm run dev` all values are optional: defaults are in src/api/config.ts.
# For `docker compose build` the 5 VITE_* below are mandatory (Dockerfile build args,
# same behavior as ../BERLink/frontend/Dockerfile): the build fails if any is missing.
# At container start the same variables can be overridden without rebuild (written to /config.js).

# Keycloak (the browser talks to Keycloak directly: must be reachable from the tablet)
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=gb-realm
VITE_KEYCLOAK_CLIENT_ID=berlink-client

# Backend API base path. Keep /api and let the dev proxy / nginx forward it.
VITE_API_URL=/api

# Default site when none was selected before
VITE_DEFAULT_SITE_ID=1

# Dev server only: where `vite` proxies /api (BERLink backend)
VITE_DEV_PROXY_TARGET=http://localhost:8090
